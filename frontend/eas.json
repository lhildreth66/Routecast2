{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "production": {
      "node": "20.19.0",
      "android": {
        "autoIncrement": false
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.routecastweather.com",
        "EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN": "unset"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.11.1",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://routecast-backend.onrender.com/api",
        "EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN": "unset"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "ascAppId": "6778445050"
      }
    }
  }
}
