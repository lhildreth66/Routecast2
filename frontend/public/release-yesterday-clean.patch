+                    placeholder="Confirm your password"
+                    placeholderTextColor="#6b7280"
+                    value={confirmPassword}
+                    onChangeText={setConfirmPassword}
+                    secureTextEntry={!showPassword}
+                    autoCapitalize="none"
+                    data-testid="signup-confirm-password-input"
